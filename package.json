{
  "name": "alamut-seo",
  "version": "1.0.1",
  "description": "Alamut SEO — full SEO suite for Payload 3: meta fields, SERP/OG/Twitter previews, content & readability analysis, JSON-LD schema, AI copy, sitemaps, redirects, tracking, Search Console, audits, analytics, and keyword research",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "seo",
    "nextjs",
    "metadata",
    "opengraph",
    "twitter-cards",
    "json-ld",
    "schema.org",
    "sitemap",
    "serp",
    "readability",
    "redirects"
  ],
  "homepage": "https://almut.ir",
  "bugs": "https://github.com/Notorious-Ali/alamut-seo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Notorious-Ali/alamut-seo.git"
  },
  "author": "AliMorbid <https://almut.ir>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "import": "./dist/exports/rsc.js",
      "types": "./dist/exports/rsc.d.ts",
      "default": "./dist/exports/rsc.js"
    },
    "./next": {
      "import": "./dist/exports/next.js",
      "types": "./dist/exports/next.d.ts",
      "default": "./dist/exports/next.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "prepublishOnly": "pnpm build",
    "prepack": "pnpm build",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "mongo": "node scripts/dev-mongo.mjs",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:generate-importmap",
    "generate:types": "pnpm dev:generate-types",
    "lint": "eslint src dev/payload.config.ts dev/int.spec.ts dev/e2e.spec.ts dev/seed.ts dev/helpers",
    "lint:fix": "eslint ./src --fix",
    "test": "pnpm test:int && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:int": "vitest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@payloadcms/db-mongodb": "3.82.1",
    "@payloadcms/db-postgres": "3.82.1",
    "@payloadcms/db-sqlite": "3.82.1",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.82.1",
    "@payloadcms/richtext-lexical": "3.82.1",
    "@payloadcms/ui": "3.82.1",
    "@playwright/test": "1.63.0",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.3.3",
    "graphql": "^16.8.1",
    "mongodb-memory-server": "10.1.4",
    "next": "16.3.3",
    "open": "^10.1.0",
    "payload": "3.82.1",
    "prettier": "^3.4.2",
    "qs-esm": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "3.0.2",
    "sharp": "0.35.4",
    "sort-package-json": "^2.10.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "payload": "^3.82.1"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@power-seo/ai": "^1.0.19",
    "@power-seo/analytics": "^1.0.19",
    "@power-seo/audit": "^1.0.19",
    "@power-seo/content-analysis": "^1.0.19",
    "@power-seo/core": "^1.0.19",
    "@power-seo/images": "^1.0.19",
    "@power-seo/integrations": "^1.0.19",
    "@power-seo/links": "^1.0.19",
    "@power-seo/meta": "^1.0.19",
    "@power-seo/readability": "^1.0.19",
    "@power-seo/redirects": "^1.0.19",
    "@power-seo/schema": "^1.0.19",
    "@power-seo/search-console": "^1.0.19",
    "@power-seo/sitemap": "^1.0.19",
    "@power-seo/tracking": "^1.0.19"
  }
}
